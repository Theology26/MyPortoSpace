# ─── Required in production ────────────────────────────────────────────────
# Admin passcode. Use a long random string (>= 12 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# This MUST be set on serverless (Vercel), where /tmp storage is not shared
# between instances — without it every instance would use its own credentials.
ADMIN_PASSCODE=

# ─── Optional ───────────────────────────────────────────────────────────────
# Set to 1 when running behind a reverse proxy (Vercel, nginx, Cloudflare).
# While unset, X-Forwarded-For is ignored so clients cannot spoof their IP
# and bypass rate limiting.
# TRUST_PROXY=1

# Extra origins allowed to read the API via CORS. Same-origin needs no config.
# CORS_ORIGINS=https://theo.dev

# GitHub auto-sync runs on every cold start by default.
# Set to 0 to disable it completely and manage repository data by hand
# (sync manually from /admin instead).
# GITHUB_AUTO_SYNC=0

# Enables HSTS. Set to production when serving over TLS.
# NODE_ENV=production

# Optional GitHub token, used only by the admin-triggered sync.
# GITHUB_TOKEN=
