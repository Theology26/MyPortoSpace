# ==============================================================
# Production Environment Variables for theoverse.my.id
# Simpan sebagai: .env di folder project di Kubuntu
# ==============================================================

NODE_ENV=production
PORT=3000

# Wajib 1 karena berada di belakang Nginx / Cloudflare Proxy
# Agar rate limiter membaca IP pengunjung asli, bukan 127.0.0.1
TRUST_PROXY=1

# Passcode Admin Dashboard
ADMIN_PASSCODE=180104

# GitHub Auto Sync (1 = aktif sync saat start, 0 = manual lewat tombol di admin)
GITHUB_AUTO_SYNC=0
GITHUB_USERNAME=Theology26

# Origin CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGINS=https://theoverse.my.id,https://www.theoverse.my.id

# Matikan unsafe-eval pada CSP setelah build statis dijalankan
BABEL_RUNTIME=0
